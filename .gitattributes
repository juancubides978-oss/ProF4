import tkinter as tk
from cliente import cliente 
from exceptions import*

def iniciar_ventana():

    ventana = tk. Tk()
    ventana.title("sistema integral de gestion de clientes, servicios y reservas (con interfas tkinter))
    ventana.geometry("800x600")

    titulo = tk.Label(
        ventana,
        text="sistema integral de gestion de clientas,servicios y reservas "
        font=("arial",16)
    )

    titulo.pack(pady=20)

    btn_cliente = tk.Button(
        ventana,
        text="gestion de clientes"
    )
    btn_cliente.pack(pady=10)

    btn_servicios = tk.Button(
        ventana,
        text="gestion de servicio"
    )
    btn_servicios.pack(pady=10)

    btn_reservas = tk.Button(
        ventana,
        text="gestion de reservas"
    )
    btn_reservas.pack(pady=10)

    ventana.mainloop() 

if __name__ == "__main__":
    iniciar_ventana()

